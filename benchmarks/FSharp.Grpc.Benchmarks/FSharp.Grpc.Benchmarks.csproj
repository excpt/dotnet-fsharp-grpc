<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
        <PackageReference Include="Google.Protobuf"/>
        <PackageReference Include="Grpc.Tools" PrivateAssets="all"/>
    </ItemGroup>

    <!-- F# types come from the generator (compiled at build time from interop.proto),
         not from the hand-written test type library. Keeps the benchmark honest:
         what we measure is what users get. -->
    <ItemGroup>
        <ProjectReference Include="../FSharp.Grpc.Benchmarks.FSharp/FSharp.Grpc.Benchmarks.FSharp.fsproj"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="../../tests/FSharp.Grpc.Integration.Tests/protos/interop.proto"
                  GrpcServices="None"
                  Link="protos/interop.proto"/>
    </ItemGroup>

</Project>
