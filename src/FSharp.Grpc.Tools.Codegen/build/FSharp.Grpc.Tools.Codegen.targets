<Project>

    <!-- Stable output dir using BaseIntermediateOutputPath (obj/) so IDE and build agree -->
    <PropertyGroup>
        <FSharpGrpc_OutputDir Condition="'$(FSharpGrpc_OutputDir)' == ''">$(BaseIntermediateOutputPath)protos/</FSharpGrpc_OutputDir>
        <FSharpGrpc_ManifestPath>$(FSharpGrpc_OutputDir)FSharpGrpc.GeneratedFiles.props</FSharpGrpc_ManifestPath>
    </PropertyGroup>

    <!-- Static import: the codegen writes <Compile Include> items in dependency order.
         Available after the first build; on first build it's populated dynamically below. -->
    <Import Project="$(FSharpGrpc_ManifestPath)" Condition="Exists('$(FSharpGrpc_ManifestPath)')"/>

    <!-- Resolve protoc from Grpc.Tools NuGet package -->
    <Target Name="_FSharpGrpc_ResolveProtoc"
            Condition="'$(FSharpGrpc_ProtocFullPath)' == '' and '$(PkgGrpc_Tools)' != ''">
        <PropertyGroup>
            <_FSharpGrpc_Os Condition="$([MSBuild]::IsOSPlatform('OSX'))">macosx</_FSharpGrpc_Os>
            <_FSharpGrpc_Os Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_FSharpGrpc_Os>
            <_FSharpGrpc_Os Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_FSharpGrpc_Os>

            <_FSharpGrpc_Cpu Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x64</_FSharpGrpc_Cpu>
            <_FSharpGrpc_Cpu Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_FSharpGrpc_Cpu>
            <_FSharpGrpc_Cpu Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X86'">x86</_FSharpGrpc_Cpu>

            <_FSharpGrpc_ProtocExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">protoc.exe</_FSharpGrpc_ProtocExe>
            <_FSharpGrpc_ProtocExe Condition="!$([MSBuild]::IsOSPlatform('Windows'))">protoc</_FSharpGrpc_ProtocExe>

            <FSharpGrpc_ProtocFullPath>$(PkgGrpc_Tools)/tools/$(_FSharpGrpc_Os)_$(_FSharpGrpc_Cpu)/$(_FSharpGrpc_ProtocExe)</FSharpGrpc_ProtocFullPath>

            <!-- Fallback: ARM64 macOS may only have x64 via Rosetta -->
            <FSharpGrpc_ProtocFullPath Condition="!Exists('$(FSharpGrpc_ProtocFullPath)') and '$(_FSharpGrpc_Cpu)' == 'arm64'">$(PkgGrpc_Tools)/tools/$(_FSharpGrpc_Os)_x64/$(_FSharpGrpc_ProtocExe)</FSharpGrpc_ProtocFullPath>

            <FSharpGrpc_WktPath>$(PkgGrpc_Tools)/build/native/include</FSharpGrpc_WktPath>
        </PropertyGroup>
    </Target>

    <!-- Resolve the codegen tool DLL: tools/ in the NuGet package, bin/ for local development -->
    <PropertyGroup>
        <_FSharpGrpc_CodegenDll Condition="'$(_FSharpGrpc_CodegenDll)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net8.0', 'FSharp.Grpc.Tools.Codegen.dll'))</_FSharpGrpc_CodegenDll>
        <_FSharpGrpc_CodegenDll Condition="!Exists('$(_FSharpGrpc_CodegenDll)')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'bin', '$(Configuration)', 'net8.0', 'FSharp.Grpc.Tools.Codegen.dll'))</_FSharpGrpc_CodegenDll>
    </PropertyGroup>

    <!-- Force regeneration: delete the manifest (the codegen target's output) so the
         incremental check below sees a missing output and re-runs unconditionally.
         Use `dotnet build -p:FSharpGrpc_ForceCodegen=true`. -->
    <Target Name="_FSharpGrpc_ForceCodegen"
            BeforeTargets="FSharpGrpc_GenerateProto"
            Condition="'$(FSharpGrpc_ForceCodegen)' == 'true' and '@(Protobuf)' != ''">
        <Delete Files="$(FSharpGrpc_ManifestPath)" TreatErrorsAsWarnings="true"/>
    </Target>

    <!-- Generate F# from .proto files (single invocation; codegen writes ordered manifest).
         Each <Protobuf> item carries its own GrpcServices value, encoded as "path|Services". -->
    <Target Name="FSharpGrpc_GenerateProto"
            BeforeTargets="BeforeCompile"
            DependsOnTargets="_FSharpGrpc_ResolveProtoc"
            Condition="'@(Protobuf)' != ''"
            Inputs="@(Protobuf);$(_FSharpGrpc_CodegenDll)"
            Outputs="$(FSharpGrpc_ManifestPath)">

        <MakeDir Directories="$(FSharpGrpc_OutputDir)"/>

        <PropertyGroup>
            <_FSharpGrpc_ProtocArg Condition="'$(FSharpGrpc_ProtocFullPath)' != ''">--protoc "$(FSharpGrpc_ProtocFullPath)"</_FSharpGrpc_ProtocArg>
            <_FSharpGrpc_WktArg Condition="'$(FSharpGrpc_WktPath)' != ''">--proto-path "$(FSharpGrpc_WktPath)"</_FSharpGrpc_WktArg>
            <_FSharpGrpc_ProtoFiles>@(Protobuf->'&quot;%(FullPath)|%(GrpcServices)&quot;', ' ')</_FSharpGrpc_ProtoFiles>
        </PropertyGroup>

        <Exec Command="dotnet &quot;$(_FSharpGrpc_CodegenDll)&quot; $(_FSharpGrpc_ProtocArg) $(_FSharpGrpc_WktArg) --output-dir &quot;$(FSharpGrpc_OutputDir)&quot; $(_FSharpGrpc_ProtoFiles)"
              StandardOutputImportance="low"/>
    </Target>

    <!-- After codegen, re-read the manifest and put generated files BEFORE user code.
         Re-reading at build time handles first-build (no static import) and changed proto sets. -->
    <Target Name="_FSharpGrpc_PrependCompile"
            BeforeTargets="BeforeCompile"
            DependsOnTargets="FSharpGrpc_GenerateProto"
            Condition="'@(Protobuf)' != '' and Exists('$(FSharpGrpc_ManifestPath)')">

        <XmlPeek XmlInputPath="$(FSharpGrpc_ManifestPath)" Query="/Project/ItemGroup/Compile/@Include">
            <Output TaskParameter="Result" ItemName="_FSharpGrpc_GeneratedCompile"/>
        </XmlPeek>

        <ItemGroup>
            <!-- Drop stale entries the static <Import> may have brought in -->
            <Compile Remove="@(_FSharpGrpc_GeneratedCompile)"/>
            <!-- Snapshot user code, then reorder: generated first, user after -->
            <_FSharpGrpc_UserCompile Include="@(Compile)"/>
            <Compile Remove="@(Compile)"/>
            <Compile Include="@(_FSharpGrpc_GeneratedCompile)"/>
            <Compile Include="@(_FSharpGrpc_UserCompile)"/>
        </ItemGroup>
    </Target>

    <!-- Clean generated files -->
    <Target Name="FSharpGrpc_Clean"
            AfterTargets="CoreClean"
            Condition="'@(Protobuf)' != ''">
        <Delete Files="@(Protobuf -> '$(FSharpGrpc_OutputDir)%(Filename).generated.fs')"
                TreatErrorsAsWarnings="true"/>
        <Delete Files="@(Protobuf -> '$(FSharpGrpc_OutputDir)%(Filename).server.generated.fs')"
                TreatErrorsAsWarnings="true"/>
        <Delete Files="@(Protobuf -> '$(FSharpGrpc_OutputDir)%(Filename).client.generated.fs')"
                TreatErrorsAsWarnings="true"/>
        <Delete Files="$(FSharpGrpc_ManifestPath)" TreatErrorsAsWarnings="true"/>
    </Target>

</Project>
