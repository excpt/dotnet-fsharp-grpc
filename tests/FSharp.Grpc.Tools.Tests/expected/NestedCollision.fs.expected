namespace rec Test

type Foo = { LocalRef: Foo.Types.Inner option }

module Foo =
    module Types =
        type Inner = { X: int }

        module Inner =
            let empty = { X = 0 }

            let computeSize (value: Inner) : int =
                let mutable size = 0

                if value.X <> 0 then
                    size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeInt32Size(value.X)

                size

            let writeTo (output: Google.Protobuf.CodedOutputStream) (value: Inner) : unit =
                if value.X <> 0 then
                    output.WriteTag(1, Google.Protobuf.WireFormat.WireType.Varint)
                    output.WriteInt32(value.X)

            let encode (value: Inner) : byte array =
                let size = computeSize value

                if size = 0 then
                    Array.empty
                else
                    let buffer = Array.zeroCreate size
                    use output = new Google.Protobuf.CodedOutputStream(buffer)
                    writeTo output value
                    output.Flush()
                    buffer

            let decodeFrom (input: Google.Protobuf.CodedInputStream) (endPos: int64) : Inner =
                let mutable _X = 0

                while input.Position < endPos do
                    let tag = input.ReadTag()

                    match Google.Protobuf.WireFormat.GetTagFieldNumber(tag) with
                    | 1 -> _X <- input.ReadInt32()
                    | _ -> input.SkipLastField()

                { X = _X }

            let decode (data: byte array) : Inner =
                use input = new Google.Protobuf.CodedInputStream(data)
                decodeFrom input (int64 data.Length)

            let writeJsonTo (writer: System.Text.Json.Utf8JsonWriter) (value: Inner) : unit =
                writer.WriteStartObject()

                if value.X <> 0 then
                    writer.WriteNumber("x", value.X)

                writer.WriteEndObject()

            let encodeJson (value: Inner) : string =
                use bufferWriter = new System.IO.MemoryStream()
                use writer = new System.Text.Json.Utf8JsonWriter(bufferWriter)
                writeJsonTo writer value
                writer.Flush()
                System.Text.Encoding.UTF8.GetString(bufferWriter.ToArray())

            let decodeJsonElement (element: System.Text.Json.JsonElement) : Inner =
                let mutable _X = 0

                for prop in element.EnumerateObject() do
                    match prop.Name with
                    | "x" -> _X <- prop.Value.GetInt32()
                    | _ -> ()

                { X = _X }

            let decodeJson (json: string) : Inner =
                use doc = System.Text.Json.JsonDocument.Parse(json)
                decodeJsonElement doc.RootElement

    let empty = { LocalRef = None }

    let computeSize (value: Foo) : int =
        let mutable size = 0

        match value.LocalRef with
        | Some v ->
            let subSize = Types.Inner.computeSize v
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeLengthSize(subSize) + subSize
        | None -> ()

        size

    let writeTo (output: Google.Protobuf.CodedOutputStream) (value: Foo) : unit =
        match value.LocalRef with
        | Some v ->
            let subSize = Types.Inner.computeSize v
            output.WriteTag(1, Google.Protobuf.WireFormat.WireType.LengthDelimited)
            output.WriteLength(subSize)
            Types.Inner.writeTo output v
        | None -> ()

    let encode (value: Foo) : byte array =
        let size = computeSize value

        if size = 0 then
            Array.empty
        else
            let buffer = Array.zeroCreate size
            use output = new Google.Protobuf.CodedOutputStream(buffer)
            writeTo output value
            output.Flush()
            buffer

    let decodeFrom (input: Google.Protobuf.CodedInputStream) (endPos: int64) : Foo =
        let mutable _LocalRef = None

        while input.Position < endPos do
            let tag = input.ReadTag()

            match Google.Protobuf.WireFormat.GetTagFieldNumber(tag) with
            | 1 ->
                let endPos = int64 (input.ReadLength()) + input.Position
                let msg = Types.Inner.decodeFrom input endPos
                _LocalRef <- Some(msg)
            | _ -> input.SkipLastField()

        { LocalRef = _LocalRef }

    let decode (data: byte array) : Foo =
        use input = new Google.Protobuf.CodedInputStream(data)
        decodeFrom input (int64 data.Length)

    let writeJsonTo (writer: System.Text.Json.Utf8JsonWriter) (value: Foo) : unit =
        writer.WriteStartObject()

        match value.LocalRef with
        | Some v ->
            writer.WritePropertyName("localRef")
            Types.Inner.writeJsonTo writer v
        | None -> ()

        writer.WriteEndObject()

    let encodeJson (value: Foo) : string =
        use bufferWriter = new System.IO.MemoryStream()
        use writer = new System.Text.Json.Utf8JsonWriter(bufferWriter)
        writeJsonTo writer value
        writer.Flush()
        System.Text.Encoding.UTF8.GetString(bufferWriter.ToArray())

    let decodeJsonElement (element: System.Text.Json.JsonElement) : Foo =
        let mutable _LocalRef = None

        for prop in element.EnumerateObject() do
            match prop.Name with
            | "localRef" -> _LocalRef <- Some(Types.Inner.decodeJsonElement prop.Value)
            | "local_ref" -> _LocalRef <- Some(Types.Inner.decodeJsonElement prop.Value)
            | _ -> ()

        { LocalRef = _LocalRef }

    let decodeJson (json: string) : Foo =
        use doc = System.Text.Json.JsonDocument.Parse(json)
        decodeJsonElement doc.RootElement

type Bar = { LocalRef: Bar.Types.Inner option }

module Bar =
