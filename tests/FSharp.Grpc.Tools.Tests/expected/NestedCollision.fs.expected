type Bar = { LocalRef: Inner option }

module Bar =
    let empty = { LocalRef = None }

    let computeSize (value: Bar) : int =
        let mutable size = 0

        match value.LocalRef with
        | Some v ->
            let subSize = Inner.computeSize v
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeLengthSize(subSize) + subSize
        | None -> ()

        size

