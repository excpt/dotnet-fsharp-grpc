            | "local_ref" -> _LocalRef <- Some(Inner.decodeJsonElement prop.Value)
            | _ -> ()

        { LocalRef = _LocalRef }

    let decodeJson (json: string) : Bar =
        use doc = System.Text.Json.JsonDocument.Parse(json)
        decodeJsonElement doc.RootElement
