namespace Broker

type FileMetadata = { TotalSize: uint64; Etag: string }

module FileMetadata =
    let empty = { TotalSize = 0UL; Etag = "" }

    let computeSize (value: FileMetadata) : int =
        let mutable size = 0

        if value.TotalSize <> 0UL then
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeUInt64Size(value.TotalSize)

        if value.Etag <> "" then
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(2) + Google.Protobuf.CodedOutputStream.ComputeStringSize(value.Etag)

        size

    let writeTo (output: Google.Protobuf.CodedOutputStream) (value: FileMetadata) : unit =
        if value.TotalSize <> 0UL then
            output.WriteTag(1, Google.Protobuf.WireFormat.WireType.Varint)
            output.WriteUInt64(value.TotalSize)

        if value.Etag <> "" then
            output.WriteTag(2, Google.Protobuf.WireFormat.WireType.LengthDelimited)
            output.WriteString(value.Etag)

    let encode (value: FileMetadata) : byte array =
        let size = computeSize value

        if size = 0 then
            Array.empty
        else
            let buffer = Array.zeroCreate size
            use output = new Google.Protobuf.CodedOutputStream(buffer)
            writeTo output value
            output.Flush()
            buffer

    let decodeFrom (input: Google.Protobuf.CodedInputStream) (endPos: int64) : FileMetadata =
        let mutable _TotalSize = 0UL
        let mutable _Etag = ""

        while input.Position < endPos do
            let tag = input.ReadTag()

            match Google.Protobuf.WireFormat.GetTagFieldNumber(tag) with
            | 1 -> _TotalSize <- input.ReadUInt64()
            | 2 -> _Etag <- input.ReadString()
            | _ -> input.SkipLastField()

        { TotalSize = _TotalSize; Etag = _Etag }

    let decode (data: byte array) : FileMetadata =
        use input = new Google.Protobuf.CodedInputStream(data)
        decodeFrom input (int64 data.Length)

    let writeJsonTo (writer: System.Text.Json.Utf8JsonWriter) (value: FileMetadata) : unit =
        writer.WriteStartObject()

        if value.TotalSize <> 0UL then
            writer.WriteString("totalSize", string value.TotalSize)

        if value.Etag <> "" then
            writer.WriteString("etag", value.Etag)

        writer.WriteEndObject()

    let encodeJson (value: FileMetadata) : string =
        use bufferWriter = new System.IO.MemoryStream()
        use writer = new System.Text.Json.Utf8JsonWriter(bufferWriter)
        writeJsonTo writer value
        writer.Flush()
        System.Text.Encoding.UTF8.GetString(bufferWriter.ToArray())

    let decodeJsonElement (element: System.Text.Json.JsonElement) : FileMetadata =
        let mutable _TotalSize = 0UL
        let mutable _Etag = ""

        for prop in element.EnumerateObject() do
            match prop.Name with
            | "totalSize" ->
                _TotalSize <-
                    if prop.Value.ValueKind = System.Text.Json.JsonValueKind.String then uint64 (prop.Value.GetString()) else prop.Value.GetUInt64()
            | "total_size" ->
                _TotalSize <-
                    if prop.Value.ValueKind = System.Text.Json.JsonValueKind.String then uint64 (prop.Value.GetString()) else prop.Value.GetUInt64()
            | "etag" -> _Etag <- prop.Value.GetString()
            | _ -> ()

        { TotalSize = _TotalSize; Etag = _Etag }

    let decodeJson (json: string) : FileMetadata =
        use doc = System.Text.Json.JsonDocument.Parse(json)
        decodeJsonElement doc.RootElement

type FileChunk = { Data: byte array; Offset: uint64 }

module FileChunk =
    let empty = { Data = Array.empty; Offset = 0UL }

    let computeSize (value: FileChunk) : int =
        let mutable size = 0

        if value.Data.Length > 0 then
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeBytesSize(Google.Protobuf.ByteString.CopyFrom(value.Data))

        if value.Offset <> 0UL then
            size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(2) + Google.Protobuf.CodedOutputStream.ComputeUInt64Size(value.Offset)

        size

    let writeTo (output: Google.Protobuf.CodedOutputStream) (value: FileChunk) : unit =
        if value.Data.Length > 0 then
            output.WriteTag(1, Google.Protobuf.WireFormat.WireType.LengthDelimited)
            output.WriteBytes(Google.Protobuf.ByteString.CopyFrom(value.Data))

        if value.Offset <> 0UL then
            output.WriteTag(2, Google.Protobuf.WireFormat.WireType.Varint)
            output.WriteUInt64(value.Offset)

    let encode (value: FileChunk) : byte array =
        let size = computeSize value

        if size = 0 then
            Array.empty
        else
            let buffer = Array.zeroCreate size
            use output = new Google.Protobuf.CodedOutputStream(buffer)
            writeTo output value
            output.Flush()
            buffer

    let decodeFrom (input: Google.Protobuf.CodedInputStream) (endPos: int64) : FileChunk =
        let mutable _Data = Array.empty
        let mutable _Offset = 0UL

        while input.Position < endPos do
            let tag = input.ReadTag()

            match Google.Protobuf.WireFormat.GetTagFieldNumber(tag) with
            | 1 -> _Data <- input.ReadBytes().ToByteArray()
            | 2 -> _Offset <- input.ReadUInt64()
            | _ -> input.SkipLastField()

        { Data = _Data; Offset = _Offset }

    let decode (data: byte array) : FileChunk =
        use input = new Google.Protobuf.CodedInputStream(data)
        decodeFrom input (int64 data.Length)

    let writeJsonTo (writer: System.Text.Json.Utf8JsonWriter) (value: FileChunk) : unit =
        writer.WriteStartObject()

        if value.Data.Length > 0 then
            writer.WriteString("data", System.Convert.ToBase64String(value.Data))

        if value.Offset <> 0UL then
            writer.WriteString("offset", string value.Offset)

        writer.WriteEndObject()

    let encodeJson (value: FileChunk) : string =
        use bufferWriter = new System.IO.MemoryStream()
        use writer = new System.Text.Json.Utf8JsonWriter(bufferWriter)
        writeJsonTo writer value
        writer.Flush()
        System.Text.Encoding.UTF8.GetString(bufferWriter.ToArray())

    let decodeJsonElement (element: System.Text.Json.JsonElement) : FileChunk =
        let mutable _Data = Array.empty
        let mutable _Offset = 0UL

        for prop in element.EnumerateObject() do
            match prop.Name with
            | "data" -> _Data <- System.Convert.FromBase64String(prop.Value.GetString())
            | "offset" ->
                _Offset <-
                    if prop.Value.ValueKind = System.Text.Json.JsonValueKind.String then uint64 (prop.Value.GetString()) else prop.Value.GetUInt64()
            | _ -> ()

        { Data = _Data; Offset = _Offset }

    let decodeJson (json: string) : FileChunk =
        use doc = System.Text.Json.JsonDocument.Parse(json)
        decodeJsonElement doc.RootElement

type FileResponsePayload =
    | Metadata of metadata: FileMetadata
    | Chunk of chunk: FileChunk

type FileResponse = { Payload: FileResponsePayload option }

module FileResponse =
    let empty = { Payload = None }

    let computeSize (value: FileResponse) : int =
        let mutable size = 0

        match value.Payload with
        | Some oneofValue ->
            match oneofValue with
            | FileResponsePayload.Metadata v ->
                let subSize = FileMetadata.computeSize v
                size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(1) + Google.Protobuf.CodedOutputStream.ComputeLengthSize(subSize) + subSize
            | FileResponsePayload.Chunk v ->
                let subSize = FileChunk.computeSize v
                size <- size + Google.Protobuf.CodedOutputStream.ComputeTagSize(2) + Google.Protobuf.CodedOutputStream.ComputeLengthSize(subSize) + subSize
        | None -> ()

        size

    let writeTo (output: Google.Protobuf.CodedOutputStream) (value: FileResponse) : unit =
        match value.Payload with
        | Some oneofValue ->
            match oneofValue with
            | FileResponsePayload.Metadata v ->
                let subSize = FileMetadata.computeSize v
                output.WriteTag(1, Google.Protobuf.WireFormat.WireType.LengthDelimited)
                output.WriteLength(subSize)
                FileMetadata.writeTo output v
            | FileResponsePayload.Chunk v ->
                let subSize = FileChunk.computeSize v
                output.WriteTag(2, Google.Protobuf.WireFormat.WireType.LengthDelimited)
                output.WriteLength(subSize)
                FileChunk.writeTo output v
        | None -> ()

    let encode (value: FileResponse) : byte array =
        let size = computeSize value

        if size = 0 then
            Array.empty
        else
            let buffer = Array.zeroCreate size
            use output = new Google.Protobuf.CodedOutputStream(buffer)
            writeTo output value
            output.Flush()
            buffer

    let decodeFrom (input: Google.Protobuf.CodedInputStream) (endPos: int64) : FileResponse =
        let mutable _Payload = None

        while input.Position < endPos do
            let tag = input.ReadTag()

            match Google.Protobuf.WireFormat.GetTagFieldNumber(tag) with
            | 1 ->
                let endPos = int64 (input.ReadLength()) + input.Position
                let msg = FileMetadata.decodeFrom input endPos
                _Payload <- Some(FileResponsePayload.Metadata(msg))
            | 2 ->
                let endPos = int64 (input.ReadLength()) + input.Position
                let msg = FileChunk.decodeFrom input endPos
                _Payload <- Some(FileResponsePayload.Chunk(msg))
            | _ -> input.SkipLastField()

        { Payload = _Payload }

    let decode (data: byte array) : FileResponse =
        use input = new Google.Protobuf.CodedInputStream(data)
        decodeFrom input (int64 data.Length)

    let writeJsonTo (writer: System.Text.Json.Utf8JsonWriter) (value: FileResponse) : unit =
        writer.WriteStartObject()

        match value.Payload with
        | Some oneofValue ->
            match oneofValue with
            | FileResponsePayload.Metadata v ->
                writer.WritePropertyName("metadata")
                FileMetadata.writeJsonTo writer v
            | FileResponsePayload.Chunk v ->
                writer.WritePropertyName("chunk")
                FileChunk.writeJsonTo writer v
        | None -> ()

        writer.WriteEndObject()

    let encodeJson (value: FileResponse) : string =
        use bufferWriter = new System.IO.MemoryStream()
        use writer = new System.Text.Json.Utf8JsonWriter(bufferWriter)
        writeJsonTo writer value
        writer.Flush()
        System.Text.Encoding.UTF8.GetString(bufferWriter.ToArray())

    let decodeJsonElement (element: System.Text.Json.JsonElement) : FileResponse =
        let mutable _Payload = None

        for prop in element.EnumerateObject() do
            match prop.Name with
            | "metadata" -> _Payload <- Some(FileResponsePayload.Metadata(FileMetadata.decodeJsonElement prop.Value))
            | "chunk" -> _Payload <- Some(FileResponsePayload.Chunk(FileChunk.decodeJsonElement prop.Value))
            | _ -> ()

        { Payload = _Payload }

    let decodeJson (json: string) : FileResponse =
        use doc = System.Text.Json.JsonDocument.Parse(json)
        decodeJsonElement doc.RootElement
