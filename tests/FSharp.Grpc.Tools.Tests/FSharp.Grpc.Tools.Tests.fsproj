<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsTestProject>true</IsTestProject>
        <!-- FSharp.Compiler.Service 43.12.204 pins FSharp.Core to 10.1.204; we use 11.0.100.
             FSharp.Core is forward-compatible at the surface FCS uses, so NU1608 is safe to suppress. -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="FabulousAstTests.fs"/>
        <Compile Include="SnapshotTypeCheck.fs"/>
        <Compile Include="ProtoToAstTests.fs"/>
        <Compile Include="ServiceGenTests.fs"/>
        <Compile Include="ProtocResolverTests.fs"/>
        <Compile Include="PipelineTests.fs"/>
        <Compile Include="ProgramTests.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="FsUnit.xUnit"/>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Fabulous.AST"/>
        <PackageReference Include="FSharp.Compiler.Service"/>
        <PackageReference Include="Grpc.Core.Api"/>
        <PackageReference Include="Grpc.Tools" PrivateAssets="all" ExcludeAssets="build" GeneratePathProperty="true"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/FSharp.Grpc.Tools/FSharp.Grpc.Tools.fsproj"/>
        <ProjectReference Include="../../src/FSharp.Grpc.Tools.Codegen/FSharp.Grpc.Tools.Codegen.fsproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="expected/**/*.expected" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="protos/**/*.proto" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
